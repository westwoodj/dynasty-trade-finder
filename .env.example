# Dynasty Trade Finder — local secrets.
#
# Copy this file to `.env` and fill in your keys. `.env` is gitignored, so
# your real keys stay out of version control. Values here are read on startup
# by src/config.py (python-dotenv). Existing shell environment variables take
# precedence over anything set here.

# SportsDataIO NFL API subscription key.
# Powers player performance stats and projections. Get one at
# https://sportsdata.io (the free tier scrambles stats ±5-20%; the app
# validates them against nflverse/nflreadpy).
SPORTSDATA_API_KEY=

# Parse API key.
# Powers dynasty market values (FantasyCalc, KeepTradeCut, DraftSharks).
# Alternatively set it in .streamlit/secrets.toml or run `uv run parse login`.
PARSE_API_KEY=
